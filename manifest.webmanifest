<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Self Raising Baker</title>
    <meta
      name="description"
      content="The Self Raising Baker offers allergen-free, diabetic-friendly cakes, bakes, breads and bespoke celebration cakes in Johannesburg."
    />
    <meta name="theme-color" content="#e8899c" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <style>
      :root {
        --bg: #fff8f4;
        --panel: #fff;
        --soft: #f7e6d9;
        --pink: #e8899c;
        --pink-deep: #cf647a;
        --peach: #f7d0b5;
        --ink: #2f241f;
        --muted: #5c463e;
        --line: rgba(47, 36, 31, 0.12);
        --shadow: 0 18px 40px rgba(85, 53, 49, 0.12);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(180deg, #fff9f8 0%, #fff7f1 100%);
        color: var(--ink);
        line-height: 1.6;
      }

      a { color: inherit; }
      img { max-width: 100%; display: block; }
      .container {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 248, 244, 0.88);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 74px;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-weight: 700;
        text-decoration: none;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--soft);
        color: var(--pink-deep);
        font-size: 1.4rem;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        font-size: 0.96rem;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--muted);
      }

      .nav-cta {
        padding: 0.72rem 1.1rem;
        border-radius: 999px;
        background: var(--pink);
        color: #fff !important;
        box-shadow: var(--shadow);
      }

      .hero {
        padding: 4rem 0 2.5rem;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        align-items: center;
        gap: 2rem;
      }

      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        color: var(--pink-deep);
        font-weight: 700;
        margin-bottom: 1rem;
      }

      h1, h2, h3 {
        margin: 0 0 1rem;
        line-height: 1.1;
      }

      h1 {
        font-size: clamp(2.5rem, 3vw + 1.5rem, 5rem);
      }

      h2 {
        font-size: clamp(2rem, 2vw + 1rem, 3rem);
      }

      p {
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .hero-card {
        background: linear-gradient(135deg, #fff5f1, #fff);
        border: 1px solid var(--line);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .hero-card img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0.8rem 1.3rem;
        border-radius: 999px;
        border: 1px solid var(--pink-deep);
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s ease;
      }

      .button:hover { transform: translateY(-1px); }
      .button.primary {
        background: var(--pink);
        border-color: var(--pink);
        color: #fff;
      }
      .button.secondary {
        background: transparent;
        color: var(--ink);
      }

      .band {
        background: #f9ece7;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 0.9rem 0;
        overflow: hidden;
      }

      .ticker {
        white-space: nowrap;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--pink-deep);
        animation: ticker 18s linear infinite;
      }

      @keyframes ticker {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      main section {
        padding: 5rem 0;
      }

      .section-head {
        margin-bottom: 2rem;
        max-width: 680px;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.25rem;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 20px rgba(31, 27, 27, 0.04);
      }

      .card-image {
        height: 200px;
        background: linear-gradient(135deg, #f8d2c4, #f6eddc);
      }

      .card-body {
        padding: 1.1rem;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0 0 0.7rem;
      }

      .tag-list li {
        background: #f8e7eb;
        color: var(--pink-deep);
        font-size: 0.75rem;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        font-weight: 700;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 1rem;
      }

      .stat {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 1rem;
        text-align: center;
      }

      .stat strong {
        display: block;
        font-size: 2rem;
        color: var(--pink-deep);
        margin-bottom: 0.15rem;
      }

      form {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
      }

      .grid-two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: start;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-bottom: 1rem;
      }

      label {
        font-weight: 700;
        color: var(--ink);
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        border: 1px solid rgba(47, 36, 31, 0.18);
        background: #fff;
        color: var(--ink);
      }

      textarea {
        min-height: 120px;
        resize: vertical;
      }

      .checkboxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.6rem;
        margin-top: 0.8rem;
      }

      .checkbox-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #fffaf8;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0.7rem 0.8rem;
      }

      .checkbox-item input { width: auto; }

      .contact-list {
        list-style: none; padding: 0; margin: 2rem 0 0;
      }

      .contact-list li {
        display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;
        color: var(--muted);
      }

      .contact-icon {
        width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center;
        border-radius: 12px; background: var(--soft); color: var(--pink-deep); font-size: 1.1rem;
      }

      footer {
        background: #2d1f1b;
        color: #f9f0ee;
        padding: 3rem 0 1rem;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr;
        gap: 2rem;
      }

      .footer-grid ul {
        list-style: none; padding: 0; margin: 0;
      }

      .footer-grid li + li { margin-top: 0.45rem; }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 2rem;
        border-top: 1px solid rgba(255,255,255,0.12);
        padding-top: 1rem;
        color: rgba(255,255,255,0.7);
      }

      @media (max-width: 760px) {
        .hero-grid, .grid-two, .footer-grid { grid-template-columns: 1fr; }
        .nav { flex-wrap: wrap; padding: 0.8rem 0; }
        .nav-links { width: 100%; justify-content: center; }
        .stats { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="#top" class="brand" aria-label="The Self Raising Baker home">
          <span class="brand-mark" aria-hidden="true">🧁</span>
          <span>The Self Raising Baker</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="#story">Our Story</a>
          <a href="#menu">Menu</a>
          <a href="#gallery">Gallery</a>
          <a href="#order" class="nav-cta">Order</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow">Baked for every table</div>
            <h1>Allergen-free bakes that feel like celebration.</h1>
            <p>
              Gluten, dairy and egg free. Beautifully made in Johannesburg for birthdays,
              weddings, gifting and everyday treats that everyone can enjoy.
            </p>
            <div class="cta-row">
              <a class="button primary" href="#order">Start an order</a>
              <a class="button secondary" href="#menu">See the menu</a>
            </div>
          </div>
          <div class="hero-card">
            <img src="https://images.unsplash.com/photo-1483695028939-5bb13f8648b0?auto=format&fit=crop&w=900&q=80" alt="Cake display from The Self Raising Baker" />
          </div>
        </div>
      </section>

      <div class="band" aria-hidden="true">
        <div class="container ticker">
          Allergen free · Gluten free · Dairy free · Egg free · Diabetic friendly · Novelty cakes · Made to order ·
          Allergen free · Gluten free · Dairy free · Egg free · Diabetic friendly · Novelty cakes · Made to order ·
        </div>
      </div>

      <section id="story">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">Our story</div>
            <h2>Baking that leaves nobody out.</h2>
          </div>
          <div class="grid-two">
            <div>
              <p>
                The Self Raising Baker started with a simple problem: someone we love could not
                eat the cake at the party. So we learned to bake without gluten, dairy and eggs,
                and we never stopped making cakes that taste as good as they look.
              </p>
              <p>
                Every order is mixed, baked and finished to order in our Johannesburg kitchen.
                Tell us what you cannot eat and what you are celebrating, and we will build the
                perfect bake around it.
              </p>
            </div>
            <div class="stats">
              <div class="stat"><strong>3</strong><span>Allergens kept out</span></div>
              <div class="stat"><strong>13</strong><span>Menu favourites</span></div>
              <div class="stat"><strong>48h</strong><span>Typical notice</span></div>
            </div>
          </div>
        </div>
      </section>

      <section id="menu">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">The menu</div>
            <h2>What comes out of our oven.</h2>
          </div>
          <div class="cards">
            <article class="card">
              <div class="card-image" aria-label="Celebration cakes"></div>
              <div class="card-body">
                <h3>Celebration &amp; Novelty Cakes</h3>
                <ul class="tag-list"><li>Gluten free</li><li>Dairy free</li><li>Egg free</li></ul>
                <p>Birthdays, weddings and custom dreams turned into cake.</p>
              </div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Cupcakes"></div>
              <div class="card-body">
                <h3>Cupcakes</h3>
                <ul class="tag-list"><li>Gluten free</li><li>Dairy free</li><li>Vegan option</li></ul>
                <p>Boxes of six or twelve for parties, gifting and little moments.</p>
              </div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Meringues"></div>
              <div class="card-body">
                <h3>Meringues</h3>
                <ul class="tag-list"><li>Gluten free</li><li>Egg free</li><li>No added sugar option</li></ul>
                <p>Light, crisp and beautiful with a diabetic-friendly option.</p>
              </div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Biscotti"></div>
              <div class="card-body">
                <h3>Biscotti</h3>
                <ul class="tag-list"><li>Gluten free</li><li>Dairy free</li><li>Vegan</li></ul>
                <p>Chocolatey, crunchy and made for dunking with coffee.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="gallery">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">Straight out the oven</div>
            <h2>A few things from the kitchen.</h2>
          </div>
          <div class="cards">
            <div class="card"><div class="card-image" style="background:linear-gradient(135deg,#f6d6c5,#f9eddd)"></div></div>
            <div class="card"><div class="card-image" style="background:linear-gradient(135deg,#eac4d2,#f3e3d2)"></div></div>
            <div class="card"><div class="card-image" style="background:linear-gradient(135deg,#d7e4dd,#f9eadc)"></div></div>
            <div class="card"><div class="card-image" style="background:linear-gradient(135deg,#f0dbbe,#f9d8d5)"></div></div>
          </div>
        </div>
      </section>

      <section id="order">
        <div class="container grid-two">
          <div>
            <div class="eyebrow">Place an order</div>
            <h2>Let’s get baking.</h2>
            <p>
              Tell us the occasion, the date and every allergy we should design around.
              We will come back with a quote usually within a day.
            </p>
            <ul class="contact-list">
              <li><span class="contact-icon">👩‍🍳</span><span><strong>Tamsin Strydom</strong><br />Baker &amp; owner</span></li>
              <li><span class="contact-icon">📞</span><span><a href="tel:+27767388373">076 738 8373</a><br />Call or WhatsApp</span></li>
              <li><span class="contact-icon">📍</span><span>Johannesburg, South Africa</span></li>
            </ul>
          </div>
          <form method="post" action="mailto:hello@example.com">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" placeholder="Name" required />
            </div>
            <div class="field">
              <label for="email">Email address</label>
              <input id="email" name="email" type="email" placeholder="Email" required />
            </div>
            <div class="field">
              <label for="item">What would you like?</label>
              <select id="item" name="item" required>
                <option value="">Choose an item</option>
                <option>Celebration cake</option>
                <option>Wedding cake</option>
                <option>Cupcakes</option>
                <option>Meringues</option>
                <option>Sandwich bread</option>
                <option>Biscotti</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field">
              <label>Allergies &amp; dietary needs</label>
              <div class="checkboxes">
                <label class="checkbox-item"><input type="checkbox" checked disabled /> Gluten free</label>
                <label class="checkbox-item"><input type="checkbox" checked disabled /> Dairy free</label>
                <label class="checkbox-item"><input type="checkbox" checked disabled /> Egg free</label>
                <label class="checkbox-item"><input type="checkbox" /> Nut free</label>
                <label class="checkbox-item"><input type="checkbox" /> Soy free</label>
                <label class="checkbox-item"><input type="checkbox" /> Vegan</label>
                <label class="checkbox-item"><input type="checkbox" /> Diabetic friendly</label>
              </div>
            </div>
            <div class="field">
              <label for="notes">Additional details</label>
              <textarea id="notes" name="notes" placeholder="Occasion, flavours, colours, timing, allergies..."></textarea>
            </div>
            <button class="button primary" type="submit">Send my order request</button>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <h3>The Self Raising Baker</h3>
          <p>For all your baking requirements.</p>
        </div>
        <div>
          <h4>Menu</h4>
          <ul>
            <li>Cakes &amp; cupcakes</li>
            <li>Meringues</li>
            <li>Quiches &amp; pies</li>
            <li>Biscotti</li>
          </ul>
        </div>
        <div>
          <h4>Get in touch</h4>
          <ul>
            <li><a href="tel:+27767388373">076 738 8373</a></li>
            <li>Johannesburg, South Africa</li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 The Self Raising Baker</span>
        <span>Allergen information is given in good faith.</span>
      </div>
    </footer>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
